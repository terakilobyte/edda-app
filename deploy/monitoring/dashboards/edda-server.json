        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(edda_trade_search_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(edda_trade_search_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(edda_trade_search_seconds_bucket[5m])))",
