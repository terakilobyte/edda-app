        }
      ]
    },
    {
      "id": 33,
      "type": "stat",
      "title": "Result-cache hit ratio (hit / all)",
      "gridPos": {
        "x": 16,
        "y": 91,
        "w": 4,
        "h": 8
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.3
              },
              {
                "color": "green",
                "value": 0.6
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "sum(edda_trade_search_cache_total{result=\"hit\"}) / clamp_min(sum(edda_trade_search_cache_total), 1)",
          "legendFormat": "hit ratio"
        }
      ],
      "description": "hit over hit+miss+filter_miss. filter_miss (added with prod's 100M-row board) is a miss that shares a live entry's sphere under different knobs; once the superset-then-filter cache ships, count hit+filter_miss as hits here."
    },
    {
      "id": 34,
      "type": "stat",
      "title": "Saturated /min (queue overflow)",
      "gridPos": {
        "x": 20,
        "y": 91,
        "w": 4,
        "h": 8
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(rate(edda_trade_search_requests_total{outcome=\"saturated\"}[5m])) * 60",
          "legendFormat": "saturated/min"
        }
      ]
    },
    {
      "id": 35,
      "type": "timeseries",
      "title": "Trade search cache /s by result",
      "gridPos": {
        "x": 0,
        "y": 99,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "description": "hit / miss / filter_miss. A hot filter_miss share is the number that justifies the superset-then-filter cache design.",
      "targets": [
        {
          "expr": "sum by (result) (rate(edda_trade_search_cache_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 36,
      "type": "stat",
      "title": "Searches slower than 10 s (share, 1h)",
      "gridPos": {
        "x": 8,
        "y": 99,
        "w": 4,
        "h": 8
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "description": "Prod cold searches measured 13-23 s on the 100M-row board (2 vCPU); pre-registered p50<5 s cold was missed. This is the mass in the 10-60 s buckets that the ledger says to watch.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "1 - sum(increase(edda_trade_search_seconds_bucket{le=\"10\"}[1h])) / clamp_min(sum(increase(edda_trade_search_seconds_count[1h])), 1)",
          "legendFormat": "share >10 s"
        }
      ]
    },
    {
      "id": 37,
      "type": "timeseries",
      "title": "Trade search latency buckets /h (10 s, 30 s, 60 s, +Inf)",
      "gridPos": {
        "x": 12,
        "y": 99,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "sum(increase(edda_trade_search_seconds_bucket{le=\"10\"}[1h]))",
          "legendFormat": "<= 10 s"
