      "gridPos": {
        "x": 0,
        "y": 91,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(edda_trade_search_requests_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Trade search latency p50 / p95 / p99 (s)",
      "gridPos": {
        "x": 8,
        "y": 91,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "fieldConfig": {
        "defaults": {
