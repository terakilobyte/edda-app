{
  "uid": "edda-server",
  "title": "EDDA Server",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "EDDN rows applied /s",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "targets": [
        {
          "expr": "rate(edda_eddn_rows_total[5m])",
          "legendFormat": "rows/s"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Artifact + app bytes served /s",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "targets": [
        {
          "expr": "rate(edda_artifact_bytes_total[5m])",
          "legendFormat": "data artifacts"
        },
        {
          "expr": "rate(edda_app_release_bytes_total[5m])",
          "legendFormat": "app releases"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Feedback by outcome",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "targets": [
        {
          "expr": "increase(edda_feedback_total[1h])",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP requests by route /s",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(edda_http_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Downloads & updates",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "App downloads by file (24h)",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "targets": [
        {
          "expr": "sum by (file) (increase(edda_app_downloads_total[24h]))",
          "legendFormat": "{{file}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Downloads (total, all versions)",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        }
      },
      "targets": [
        {
          "expr": "sum(edda_app_downloads_total)",
          "legendFormat": "downloads"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Update checks /h",
      "gridPos": {
        "x": 18,
        "y": 17,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "targets": [
        {
          "expr": "sum(increase(edda_update_checks_total[1h]))",
          "legendFormat": "checks/h"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Community delta build \u2014 nightly market (00:05 UTC)",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Time since last successful build",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90000
              },
              {
                "color": "red",
                "value": 93600
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "time() - max(edda_publish_last_complete_unix_seconds{product=\"market_daily\"})",
          "legendFormat": "since last build"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Build cost \u2014 wall vs CPU (s)",
      "gridPos": {
        "x": 6,
        "y": 26,
        "w": 9,
        "h": 7
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "max(edda_publish_build_seconds{product=\"market_daily\"})",
          "legendFormat": "wall"
        },
        {
          "expr": "max(edda_publish_cpu_seconds{product=\"market_daily\"})",
          "legendFormat": "cpu"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Build phases (s)",
      "gridPos": {
        "x": 15,
        "y": 26,
        "w": 9,
        "h": 7
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "targets": [
        {
          "expr": "max by (phase) (edda_publish_phase_seconds{product=\"market_daily\"})",
          "legendFormat": "{{phase}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Rows published (nightly)",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        }
      },
      "targets": [
        {
          "expr": "max(edda_publish_rows{product=\"market_daily\"})",
          "legendFormat": "rows"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Bytes published",
      "gridPos": {
        "x": 6,
        "y": 33,
        "w": 9,
        "h": 7
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "max(edda_publish_bytes{product=\"market_daily\"})",
          "legendFormat": "bytes"
        }
      ]
    },
    {
      "id": 15,
      "type": "row",
      "title": "Market search \u2014 /v1/market/search",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Requests /s by outcome",
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(edda_market_search_requests_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99 (s)",
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(edda_market_search_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(edda_market_search_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(edda_market_search_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 18,
      "type": "row",
      "title": "Postgres",
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Database size (edda)",
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1
        }
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=\"edda\"}",
          "legendFormat": "size"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Connections (used vs max)",
      "gridPos": {
        "x": 6,
        "y": 50,
        "w": 9,
        "h": 7
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{datname=\"edda\"}",
          "legendFormat": "backends"
        },
        {
          "expr": "pg_settings_max_connections",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Transactions /s (commit / rollback)",
      "gridPos": {
        "x": 15,
        "y": 50,
        "w": 9,
        "h": 7
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=\"edda\"}[5m])",
          "legendFormat": "commit"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"edda\"}[5m])",
          "legendFormat": "rollback"
        }
      ]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Cache hit ratio (lifetime)",
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "uid": "edda-vm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "pg_stat_database_blks_hit{datname=\"edda\"} / clamp_min(pg_stat_database_blks_hit{datname=\"edda\"} + pg_stat_database_blks_read{datname=\"edda\"}, 1)",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 23,
      "type": "row",
      "title": "Route API \u2014 /v1/route",
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
