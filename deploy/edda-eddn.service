[Unit]
Description=EDDA EDDN ingest (the feed as its own process; Postgres is the handoff)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=edda
Group=edda
EnvironmentFile=/etc/edda/api.env
Environment=EDDA_API_INGEST_BIND=127.0.0.1:8788
ExecStart=/usr/local/bin/ed-api ingest
Restart=always
RestartSec=5
# Same hardening as edda-api.service: owns only its state dir, speaks
# only TCP, no path to privileges, kernel surfaces, or other users' memory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/edda
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
