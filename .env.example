# EDDA API service (crates/ed-api). Copy to .env and load it:
#   set -a; source .env; set +a
# Values match compose.yaml.

# PostgreSQL the service owns. Created by `docker compose up -d postgres`.
DATABASE_URL=postgres://edda:edda@127.0.0.1:55432/edda

# Address the HTTP server listens on.
EDDA_API_BIND=127.0.0.1:8787

# Where published artifacts (community EBEX, routing EDGX) and current.json
# live. Served under /v1/artifacts/.
EDDA_API_ARTIFACT_DIR=.data/api/artifacts

# Optional: a separate database for the ignored integration tests
# (`cargo test -p ed-api --test postgres -- --ignored`). It is truncated.
# EDDA_API_TEST_DATABASE_URL=postgres://edda:edda@127.0.0.1:55432/edda_test

# Optional: EDDN relay and writer queue.
# EDDA_API_EDDN_RELAY=tcp://eddn.edcd.io:9500
# EDDA_API_EDDN_QUEUE_CAPACITY=10000
# RUST_LOG=ed_api=info
